{
  "name": "sprint-serve-ai-assistants",
  "version": "0.1.0",
  "private": true,
  "description": "Guest \"help me choose\" and owner business assistants for a restaurant, powered by Meta Muse Spark, extracted from Sprint Serve to prototype and demo standalone.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/server.ts",
    "start": "tsx --disable-warning=ExperimentalWarning src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "node scripts/assistant-eval.mjs",
    "stub": "node scripts/assistant-model-stub.mjs",
    "eval:adversarial": "node scripts/make-adversarial-data.mjs",
    "db:reset": "tsx --disable-warning=ExperimentalWarning src/db/reset.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "tsx": "4.19.4",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
