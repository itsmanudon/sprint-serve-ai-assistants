# Copy to .env. Never commit .env.

# Turn the assistant on and point it at Meta's Model API (OpenAI-compatible).
ASSISTANT_ENABLED=true
ASSISTANT_MODEL_BASE_URL=https://api.meta.ai/v1
ASSISTANT_MODEL=muse-spark-1.3
ASSISTANT_MODEL_API_KEY=
ASSISTANT_REASONING_EFFORT=minimal
ASSISTANT_MODEL_TIMEOUT_MS=20000

# Adds token usage to each reply (the eval script needs it). Never on in production.
ASSISTANT_DEBUG_USAGE=true

PORT=3000

# Offline wiring check without a key: run `npm run stub` and use
#   ASSISTANT_MODEL_API_KEY=local-stub-key
#   ASSISTANT_MODEL_BASE_URL=http://127.0.0.1:4010/v1
